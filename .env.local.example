.env.local.example# Supabase — copy this file to .env.local and fill in the real values.
# Get these from: Supabase dashboard → your project → Settings → API
#
# NEXT_PUBLIC_ prefix means these values are safe to expose to the browser.
# The anon key is intentionally public; Row Level Security controls what it can do.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

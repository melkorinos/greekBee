.env.local.example# Supabase — copy this file to .env.local and fill in the real values.
# Get these from: Supabase dashboard → your project → Settings → API
#
# NEXT_PUBLIC_ prefix means these values are safe to expose to the browser.
# The anon key is intentionally public; Row Level Security controls what it can do.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Leksikastirio admin access — append ?admin=<value> to /leksikastirio URL to unlock triage controls.
# The review API validates this server-side; never expose it publicly.
ADMIN_SECRET=your-admin-secret-here

# Leksikastirio CLI — needed only for scripts/apply-nominations.mjs (runs locally, never on Vercel).
# Get this from: Supabase dashboard → your project → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Feedback form (Shell → "Σχόλια / Πρόβλημα") — routes player messages to your
# email via FormSubmit (https://formsubmit.co). No account needed: the first
# submission triggers a one-click confirmation email; approve it once and you're
# done. Value is your email, OR (recommended) a FormSubmit hashed alias so your
# raw email isn't in the client bundle — you get the alias after activating.
# NEXT_PUBLIC_ because it's used client-side. Also add it to Vercel project env.
NEXT_PUBLIC_FORMSUBMIT_ID=your-email-or-formsubmit-alias-here

# Database backups (`npm run db:backup`) — local only, never used by the app or by
# Vercel. See docs/disaster-recovery.md.
#
# Connection string: Supabase dashboard → Settings → Database → Connect →
# Session pooler → URI. PGPASSWORD is that same database password on its own.
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres
PGPASSWORD=your-database-password-here

# Password for the encrypted .7z the backup script produces. The dump contains
# player emails (auth.users), so the archive is AES-256 encrypted before it goes
# anywhere. STORE THIS IN A PASSWORD MANAGER TOO — if the machine dies with the
# only copy of the password, every archive you saved becomes unreadable.
BACKUP_ARCHIVE_PASSWORD=a-long-random-passphrase
